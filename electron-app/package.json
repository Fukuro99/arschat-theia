{
  "private": true,
  "name": "electron-app",
  "version": "0.0.1",
  "main": "lib/backend/electron-main.js",
  "dependencies": {
    "@theia/ai-anthropic": "1.71.2",
    "@theia/ai-chat": "1.71.2",
    "@theia/ai-chat-ui": "1.71.2",
    "@theia/ai-core": "1.71.2",
    "@theia/ai-mcp": "1.71.2",
    "@theia/core": "1.71.2",
    "@theia/editor": "1.71.2",
    "@theia/electron": "1.71.2",
    "@theia/filesystem": "1.71.2",
    "@theia/markers": "1.71.2",
    "@theia/messages": "1.71.2",
    "@theia/monaco": "1.71.2",
    "@theia/navigator": "1.71.2",
    "@theia/plugin-ext": "1.71.2",
    "@theia/plugin-ext-vscode": "1.71.2",
    "@theia/preferences": "1.71.2",
    "@theia/process": "1.71.2",
    "@theia/terminal": "1.71.2",
    "@theia/vsx-registry": "1.71.2",
    "@theia/workspace": "1.71.2",
    "arschat-agents": "0.0.1",
    "arschat-branding": "0.0.1",
    "arschat-chat": "0.0.1",
    "arschat-providers": "0.0.1",
    "arschat-tools": "0.0.1"
  },
  "devDependencies": {
    "@theia/cli": "1.71.2",
    "electron": "39.8.7",
    "terser-webpack-plugin": "^5.3.11"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ..",
    "start": "theia start --plugins=local-dir:plugins",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "ArsChat",
        "preferences": {
          "workbench.statusBar.visible": false,
          "workbench.colorTheme": "Dracula Theme",
          "security.workspace.trust.enabled": false,
          "ai-features.mcp.mcpServers": {
            "everything": {
              "command": "npx",
              "args": ["-y", "@modelcontextprotocol/server-everything"],
              "autostart": true
            }
          }
        }
      }
    }
  },
  "theiaPluginsDir": "plugins"
}
