{
  "name": "arschat-branding",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.0.1",
  "description": "ArsChat branding: tray / global shortcut / widget window / window icon / quit-suppression (electron-main) plus frontend IDE-dilution and PoC regression autotests",
  "author": "Fukuro99",
  "license": "MIT",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/ai-chat": "1.71.2",
    "@theia/ai-chat-ui": "1.71.2",
    "@theia/ai-core": "1.71.2",
    "@theia/ai-mcp": "1.71.2",
    "@theia/core": "1.71.2",
    "@theia/editor": "1.71.2",
    "@theia/markers": "1.71.2",
    "@theia/monaco": "1.71.2",
    "@theia/plugin-ext": "1.71.2",
    "@theia/terminal": "1.71.2",
    "@theia/workspace": "1.71.2",
    "arschat-chat": "0.0.1"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/arschat-branding-frontend-module"
    },
    {
      "electronMain": "lib/electron-main/arschat-branding-electron-main-module"
    }
  ]
}
