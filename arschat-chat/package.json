{
  "name": "arschat-chat",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.0.1",
  "description": "ArsChat chat UI: main-area chat ReactWidget (streaming, Markdown+syntax highlight, <think> folding, image attach, abort) + session history panel view",
  "author": "Fukuro99",
  "license": "MIT",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/ai-chat": "1.71.2",
    "@theia/ai-chat-ui": "1.71.2",
    "@theia/ai-core": "1.71.2",
    "@theia/core": "1.71.2",
    "@theia/filesystem": "1.71.2",
    "@theia/terminal": "1.71.2",
    "@theia/workspace": "1.71.2",
    "arschat-agents": "0.0.1",
    "arschat-tools": "0.0.1",
    "arschat-providers": "0.0.1",
    "dompurify": "^3.1.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.38",
    "marked": "^14.0.0",
    "marked-katex-extension": "^5.1.7"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "ts-node": "^10.9.1",
    "ts-jest": "^29.1.0"
  },
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --config configs/jest.config.ts"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/arschat-chat-frontend-module"
